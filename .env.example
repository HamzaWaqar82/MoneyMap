# Copy this to .env and fill in values. Do NOT commit your real .env

# VAPID keys for Web Push (generate once, keep private)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Mailer (optional - for development ethereal defaults are used)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# App config
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/moneymap
