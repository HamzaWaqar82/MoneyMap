		"cors": "^2.8.6",
		"csv-parse": "^6.2.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-validator": "^7.3.2",
		"helmet": "^8.1.0",
		"joi": "^18.1.2",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.5.0",
		"multer": "^2.1.1"
	},
	"devDependencies": {
		"jest": "^30.4.2",
